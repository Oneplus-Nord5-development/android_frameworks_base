<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Theme.AppCompat.DayNight"
    android:background="?android:colorBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="160dp"/>

    <LinearLayout
        android:id="@+id/custom_password_view"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="24dp"
        android:layout_marginTop="-120dp"
        android:background="@drawable/rounded_bg_app_lock">

        <EditText
            android:id="@+id/custom_password_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:hint="App Lock Password"
            android:textAlignment="center"
            android:textSize="18sp"
            android:padding="12dp"
            android:singleLine="true"/>

        <com.android.internal.widget.LockPatternView
            android:id="@+id/custom_pattern_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/custom_password_submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="32dp"
            android:text="@android:string/ok"/>
    </LinearLayout>

</LinearLayout>
